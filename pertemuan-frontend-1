            <div class="status-indicator">
                <span class="dot active"></span>
                <p id="status-text">
                    Client-Side Antarmuka Siap (Menunggu Request)
                </p>
            </div>
        </section>

    </main>

    <footer class="app-footer">
        <div class="container">
